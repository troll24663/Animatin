-- Krystal Dance V3 - Animation Selector GUI + Custom Animation
-- Paste this as a LocalScript or run via executor

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Player = Players.LocalPlayer
local Mouse = Player:GetMouse()

repeat wait() until Player.Character
local Character = Player.Character
local Humanoid = Character:WaitForChild("Humanoid")
local Root = Character:WaitForChild("HumanoidRootPart")
local Torso = Character:WaitForChild("Torso")
local Head = Character:WaitForChild("Head")
local LeftArm = Character:WaitForChild("Left Arm")
local RightArm = Character:WaitForChild("Right Arm")
local LeftLeg = Character:WaitForChild("Left Leg")
local RightLeg = Character:WaitForChild("Right Leg")

local dancing = false
local currentSound = nil
local currentKey = nil
local sine = 0
local change = 0.5
local ws = 14

local function makeWeld(name, part0, part1, c0)
	local w = Instance.new("ManualWeld")
	w.Name = name
	w.Part0 = part0
	w.Part1 = part1
	w.C0 = c0
	w.Parent = part0
	return w
end

local ROOTLERP = makeWeld("ROOTLERP", Root, Torso, CFrame.new(0,0,0))
local HEADLERP = makeWeld("HEADLERP", Head, Head, CFrame.new(0,-1.5,0))
local RIGHTARMLERP = makeWeld("RIGHTARMLERP", RightArm, Torso, CFrame.new(-1.5,0,0))
local LEFTARMLERP = makeWeld("LEFTARMLERP", LeftArm, Torso, CFrame.new(1.5,0,0))
local RIGHTLEGLERP = makeWeld("RIGHTLEGLERP", RightLeg, Torso, CFrame.new(-0.5,2,0))
local LEFTLEGLERP = makeWeld("LEFTLEGLERP", LeftLeg, Torso, CFrame.new(0.5,2,0))

local function swait(n)
	n = n or 0
	for i = 0, n do
		RunService.Stepped:Wait()
	end
end

local function stopDance()
	dancing = false
	if currentSound then
		currentSound:Stop()
		currentSound:Destroy()
		currentSound = nil
	end
	Humanoid.WalkSpeed = ws
	currentKey = nil
end

local function playSound(id, loop, timepos)
	if currentSound then
		currentSound:Stop()
		currentSound:Destroy()
	end
	local s = Instance.new("Sound", Torso)
	s.SoundId = "rbxassetid://" .. id
	s.Volume = 6
	s.Looped = loop or true
	if timepos then s.TimePosition = timepos end
	s:Play()
	currentSound = s
	return s
end

