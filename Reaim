Mouse.KeyDown:Connect(function(key)
    local k = key:upper()
    if Animations[k] then
        playAnimation(k)
        local refs = btnRefs[k]
        if refs then
            if selectedBtn and selectedBtn ~= refs.btn then
                selectedBtn.BackgroundColor3 = Color3.fromRGB(15, 5, 30)
                local old = btnRefs[currentKey or ""]
                if old then old.stroke.Color = Color3.fromRGB(60, 0, 120) end
            end
            selectedBtn = refs.btn
            refs.btn.BackgroundColor3 = Color3.fromRGB(30, 5, 55)
            refs.stroke.Color = Color3.fromRGB(180, 60, 255)
        end
    end
end)

RunService.RenderStepped:Connect(function()
